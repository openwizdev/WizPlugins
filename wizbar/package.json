{
  "name": "bb-plugin-wizbar",
  "version": "0.3.0",
  "type": "module",
  "description": "An agent-first sidebar for fleets of agent threads: cards with the issue or pull request link and child count, children on hover, a live running count with a stats panel, drag to pin, and a wizbar CLI with JSON for every WizBar action.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openwizdev/wizplugins.git",
    "directory": "wizbar"
  },
  "homepage": "https://github.com/openwizdev/wizplugins/tree/main/wizbar",
  "engines": {
    "bb": ">=0.37.0",
    "bbPluginSdk": ">=0.4.3"
  },
  "bb": {
    "name": "WizBar",
    "description": "OpenWiz inbox-style sidebar: one flat list of cards that never re-orders.",
    "branding": {
      "icon": "Zap"
    },
    "app": "./app.tsx",
    "server": "./src/server.ts"
  },
  "keywords": [
    "bb-plugin",
    "sidebar",
    "threads",
    "inbox",
    "agents",
    "fleet",
    "cli"
  ],
  "scripts": {
    "build": "room-cli plugin build .",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.33",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "bb-app": "0.37.0",
    "cron-parser": "^5.5.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1",
    "@types/better-sqlite3": "^7.6.12",
    "better-sqlite3": "12.10.0",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-select": "^2.3.3"
  }
}
