{
  "name": "wizbar-board-core",
  "private": true,
  "type": "module",
  "description": "WizBar's board core: the view interface every board view is written against, and the rail that lists them",
  "engines": { "node": ">=24" },
  "scripts": {
    "test": "node --test \"**/*.test.ts\"",
