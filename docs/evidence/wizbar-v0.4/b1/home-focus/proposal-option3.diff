+import type { DeckWatchResultV1 } from "../data/server";
+import type { BoardV1 } from "../data/board";
+import { openWizDeck, setSelection } from "../selection/selection";
+import { HEARTBEAT_MS } from "./useDeckHome";
+
+// The route: which thread the focused pane shows (useBbContext's threadId).
+const route = vi.hoisted(() => ({ threadId: "thr_t1" as string | null, listeners: new Set<() => void>() }));
+const setRoute = (threadId: string | null) => { route.threadId = threadId; for (const listener of [...route.listeners]) listener(); };
